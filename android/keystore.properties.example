# Copy this file to "keystore.properties" (same folder) and fill in your
# real values. keystore.properties itself is gitignored — never commit your
# real keystore path/passwords.
#
# Generate the keystore first (one-time, keep the .keystore file and these
# passwords safe forever — losing them means you can never publish an update
# to this app under the same Play Store listing again):
#
#   keytool -genkey -v -keystore delcargo-release.keystore -alias delcargo -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the android/ project root.
storeFile=delcargo-release.keystore
storePassword=CHANGE_ME
keyAlias=delcargo
keyPassword=CHANGE_ME
