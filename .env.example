# Copy this file to .env.local (never commit the real .env.local) and fill
# in real values. Used only by the server-side Forgot Password / OTP email
# feature (src/app/api/auth/forgot-password, src/app/api/auth/reset-password).
#
# PocketBase's own JS hooks (pb_hooks/*.js) run in a limited script engine
# that can only make plain HTTP calls, not raw SMTP socket connections — so
# these emails are sent from this Next.js app instead (real Node.js via
# nodemailer), not from a pb_hook.
#
# These SMTP credentials come from the mailbox created in Namecheap's
# webmail / cPanel (Email Accounts -> Connect Devices / Configure Mail
# Client) for noreply@delcargo.us — confirmed from that page's "Secure
# SSL/TLS Settings" panel: outgoing server delcargo.us, SMTP port 465.

# RESEND_API_KEY: Used by Resend REST API for edge email sending.
RESEND_API_KEY=

# SMTP_FROM: The "From" header shown to recipients (must be a verified sender domain in Resend).
SMTP_FROM="Delcargo HR <noreply@delcargo.us>"

# Deprecated SMTP Settings (kept for reference, but no longer used by Edge runtime)
# SMTP_HOST=delcargo.us
# SMTP_PORT=465
# SMTP_USER=noreply@delcargo.us
# SMTP_PASS=

# The mobile app (Android/iOS) is a static Capacitor build with no server of
# its own, so it needs the full deployed site URL to reach this app's own
# API routes (e.g. /api/auth/forgot-password) — see src/lib/apiBase.ts.
# Current production URL as of 2026-08-04; update this (and rebuild the
# native apps) if/when the site moves to a custom subdomain.
NEXT_PUBLIC_SITE_URL=https://delcargo-io.vercel.app

# Google OAuth Credentials for Calendar Sync, Meet & Gmail 2FA Integration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
