# Copy this file to .env.local (never commit the real .env.local) and fill
# in real values. Used only by the server-side Forgot Password / OTP email
# feature (src/app/api/auth/forgot-password, src/app/api/auth/reset-password).
#
# PocketBase's own JS hooks (pb_hooks/*.js) run in a limited script engine
# that can only make plain HTTP calls, not raw SMTP socket connections — so
# these emails are sent from this Next.js app instead (real Node.js via
# nodemailer), not from a pb_hook.
#
# These SMTP credentials come from the mailbox created in Namecheap's
# webmail / cPanel (Email Accounts -> Connect Devices / Configure Mail
# Client) for noreply@delcargo.us — confirmed from that page's "Secure
# SSL/TLS Settings" panel: outgoing server delcargo.us, SMTP port 465.

# RESEND_API_KEY: Used by Resend REST API for edge email sending.
RESEND_API_KEY=

# SMTP_FROM: The "From" header shown to recipients (must be a verified sender domain in Resend).
SMTP_FROM="Delcargo HR <noreply@delcargo.us>"

# Deprecated SMTP Settings (kept for reference, but no longer used by Edge runtime)
# SMTP_HOST=delcargo.us
# SMTP_PORT=465
# SMTP_USER=noreply@delcargo.us
# SMTP_PASS=

# The mobile app (Android/iOS) is a static Capacitor build with no server of
# its own, so it needs the full deployed site URL to reach this app's own
# API routes (e.g. /api/auth/forgot-password) — see src/lib/apiBase.ts.
# Current production URL as of 2026-08-04; update this (and rebuild the
# native apps) if/when the site moves to a custom subdomain.
NEXT_PUBLIC_SITE_URL=https://delcargo-io.vercel.app

# Google OAuth Credentials for Calendar Sync, Meet & Gmail 2FA Integration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Server-side login / payroll refactor ────────────────────────────────
# See src/app/api/auth/login, src/app/api/payroll/me, src/lib/pbAdmin.ts,
# src/lib/serverAuth.ts. These replace the old client-side password check
# and the old "fetch everyone's salary into the browser" pattern.

# PB_ADMIN_EMAIL / PB_ADMIN_PASSWORD: a dedicated PocketBase admin
# (superuser) account, used ONLY server-side (never sent to the browser).
# Create a NEW admin account for this in the PocketBase Admin UI
# (https://pb.delcargo.us/_/ -> Settings -> Admins) rather than reusing any
# existing one — this account's credentials will live in your deployment
# platform's env vars (Cloudflare Pages project settings), so treat it as a
# real secret, same as RESEND_API_KEY above.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# SESSION_JWT_SECRET: any long random string (e.g. `openssl rand -hex 32`),
# used to sign/verify the session token issued at login. Changing this
# value instantly invalidates every existing signed-in session (forces
# everyone to log in again) — that's a legitimate thing to do deliberately
# (e.g. if this secret is ever suspected leaked), just not something to
# rotate casually.
SESSION_JWT_SECRET=

# Optional: the two special-case logins that used to be hardcoded directly
# in src/app/auth/page.tsx's client bundle (visible to anyone in browser
# dev tools). Leave all of these blank to simply disable both special
# logins — safe default, not a broken one. To re-enable, set:
#   SUPERADMIN_LOGIN_EMAIL       — the alias email typed at the login screen
#   SUPERADMIN_LOGIN_PASSWORD_HASH — bcrypt hash of a NEW password (never
#                                    reuse the old leaked one) — generate
#                                    with: node -e "console.log(require('bcryptjs').hashSync('your-new-password', 10))"
#   SUPERADMIN_TARGET_EMAIL      — the real hr_profiles account this alias
#                                  logs into (e.g. admin@delcargo.us)
#   HR_MASTER_LOGIN_EMAIL / HR_MASTER_LOGIN_PASSWORD_HASH — same idea, role 'hr'
SUPERADMIN_LOGIN_EMAIL=
SUPERADMIN_LOGIN_PASSWORD_HASH=
SUPERADMIN_TARGET_EMAIL=
HR_MASTER_LOGIN_EMAIL=
HR_MASTER_LOGIN_PASSWORD_HASH=
