{
  "manifest_version": 3,
  "name": "Delcargo HR Tracker",
  "version": "1.0.8",
  "description": "Official Delcargo HR activity tracker and time logger extension for Chromebooks & Chrome Browser.",
  "update_url": "https://raw.githubusercontent.com/SPARXzeux/HR-Web-App/main/chrome-extension/updates.xml",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Delcargo HR Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "idle",
    "storage",
    "alarms",
    "tabs",
    "activeTab",
    "desktopCapture",
    "notifications",
    "offscreen",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://pb.delcargo.us/*",
    "https://delcargo-io.vercel.app/*",
    "http://localhost:8090/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
