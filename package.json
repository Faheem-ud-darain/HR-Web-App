{
  "name": "delcargo-hr-website",
  "version": "1.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:capacitor": "node scripts/build-for-capacitor.mjs",
    "cap:sync": "npm run build:capacitor && npx cap sync android",
