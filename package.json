    "cap:ios": "npm run build:capacitor && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capgo/background-geolocation": "^8.0.32",
    "@duo-icons/tailwind": "*",
    "@onesignal/capacitor-plugin": "^1.1.2",
    "@tanstack/react-query": "^5.101.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "nodemailer": "^6.9.16",
    "pocketbase": "^0.27.0",
    "react": "19.2.4",
